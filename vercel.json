{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/faq\\.html",
      "status": 301,
      "headers": {
        "Location": "/faq"
      }
    },
    {
      "src": "/instructors\\.html",
      "status": 301,
      "headers": {
        "Location": "/instructor"
      }
    },
    {
      "src": "/reviews\\.html",
      "status": 301,
      "headers": {
        "Location": "/reviews"
      }
    },
    {
      "src": "/blog\\.html",
      "status": 301,
      "headers": {
        "Location": "/blog"
      }
    },
    {
      "src": "/terms\\.html",
      "status": 301,
      "headers": {
        "Location": "/policy/terms"
      }
    },
    {
      "src": "/privacy\\.html",
      "status": 301,
      "headers": {
        "Location": "/policy/privacy"
      }
    },
    {
      "src": "/refund\\.html",
      "status": 301,
      "headers": {
        "Location": "/policy/refund"
      }
    },
    {
      "src": "/index\\.html",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/subtitle-tool\\.html",
      "status": 301,
      "headers": {
        "Location": "/tadaksync-auto"
      }
    },
    {
      "src": "/(faq|instructor|reviews|blog|courses)/",
      "status": 301,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/policy/(refund|privacy|terms)/",
      "status": 301,
      "headers": {
        "Location": "/policy/$1"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/",
      "dest": "server.js"
    },
    {
      "src": "/course\\.html",
      "dest": "server.js"
    },
    {
      "src": "/((?!course\\.html).*\\.html)",
      "dest": "/public/$1",
      "headers": {
        "Cache-Control": "private, no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
